PGAGENT_HOST=127.0.0.1
PGAGENT_PORT=8765
PGAGENT_LOG_LEVEL=INFO
PGAGENT_MAX_STEPS=0
PGAGENT_MAX_TOOL_CALLS=0
PGAGENT_MAX_IDENTICAL_CALLS=0
PGAGENT_NO_PROGRESS_LIMIT=0
PGAGENT_MODEL_TIMEOUT_SECONDS=300
# 父任务同步等待子 Agent 的窗口；超时只让出控制权，不停止子任务。
PGAGENT_DELEGATED_WAIT_TIMEOUT_SECONDS=30
# 普通任务默认不设统一墙钟上限；需要时再配置 PGAGENT_MAX_RUN_SECONDS。
# 可选的单次 Run token 预算；留空时不限制。
# PGAGENT_MAX_TASK_TOKENS=200000
PGAGENT_CONTEXT_LIMIT_TOKENS=200000
PGAGENT_COMPACT_THRESHOLD_TOKENS=180000
PGAGENT_COMPLETION_VERIFICATION_MAX_ATTEMPTS=3
# Long-lived Skill marketplace gateway. Configure both values together.
# PGAGENT_SKILL_MARKET_URL=https://pgagent-skills.vercel.app
# PGAGENT_SKILL_MARKET_CLIENT_TOKEN=replace-with-the-gateway-client-token
# Optional override. The default MCP config is data/mcp.json.
# PGAGENT_MCP_CONFIG_PATH=C:\path\to\mcp.json
